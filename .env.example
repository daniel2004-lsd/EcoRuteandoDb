# ==============================================================================
# EcoRuteandoDb — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values as needed for local development.
# Do NOT commit the actual .env file or real secrets to version control.
# ==============================================================================

# Database Name (Optional, default: ecoRuteando_db)
POSTGRES_DB=ecoRuteando_db

# Database User (Optional, default: postgres)
POSTGRES_USER=postgres

# Database Password (Required for non-default setups, default in compose: postgres)
# Replace with a strong, secure password in production or shared environments.
POSTGRES_PASSWORD=postgres

# Host Port (Optional, default: 5450)
# Mapped to container port 5432 to avoid collision with standard local PostgreSQL 5432.
POSTGRES_PORT=5450